# ============================================================
# Discord
# ============================================================
# Bot token — Discord Developer Portal → Bot → Reset Token
# Never commit the real value. Set it in Bot-Hosting panel.
DISCORD_TOKEN=

# Application ID — Discord Developer Portal → General Information → Application ID
# Used only for the /help slash command registration.
DISCORD_CLIENT_ID=

# ============================================================
# Supabase
# ============================================================
# Project URL — Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Service role key — Supabase Dashboard → Project Settings → API → service_role
# SERVER-SIDE ONLY. This key bypasses RLS. Never expose it to a browser,
# never commit it, never log it. Mark it as a secret in the Bot-Hosting panel.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Bot behavior
# ============================================================
# Prefix for all bot commands. Defaults to * if not set.
PREFIX=*
